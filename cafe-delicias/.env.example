# Copie para .env. Não inclua credenciais no Git nem envie segredos pelo chat.
PORT=3180
HOST=127.0.0.1
# Opcional. Se ausente, uma senha é gerada no primeiro início em data/acesso-admin.txt.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# Contas administrativas adicionais (objeto JSON de usuário para senha):
# ADMIN_ACCOUNTS='{}'
# Configure no servidor quando houver domínio HTTPS público:
# PUBLIC_BASE_URL=https://sua-loja.example
# MP_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# Checkout Transparente do Mercado Pago (Payments API):
# MP_TRANSPARENT_PUBLIC_KEY=
# MP_TRANSPARENT_ACCESS_TOKEN=
# MP_TRANSPARENT_WEBHOOK_SECRET=
# MP_ORDERS_CHECKOUT=true
# Volume persistente opcional (caminho absoluto):
# DATA_DIR=D:/dados/cafe-delicias
