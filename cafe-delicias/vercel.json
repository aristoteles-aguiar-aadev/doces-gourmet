{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "buildCommand": "node --check server.mjs && node --check api/index.mjs",
  "outputDirectory": "public",
  "functions": { "api/index.mjs": { "includeFiles": "public/**", "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=/api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api/index?__route=/uploads/:path*" },
    { "source": "/admin", "destination": "/api/index?__route=/admin" },
    { "source": "/admin/", "destination": "/api/index?__route=/admin" }
  ],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Referrer-Policy","value":"same-origin"},
    {"key":"Cache-Control","value":"no-cache"}
  ]}]
}
